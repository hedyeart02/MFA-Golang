# ==============================================================================
# SAMLGuard Production Configuration Template
# ==============================================================================

# Environment profile ("production" or "development")
# When set to production, strict security controls and HTTPS enforcement are active.
env: "production"

server:
  host: "0.0.0.0"
  port: 8443
  read_timeout: 30s
  write_timeout: 30s
  shutdown_timeout: 15s
  tls_enabled: true
  tls_cert_file: "./cert/server.crt"
  tls_key_file: "./cert/server.key"

database:
  driver: "sqlite"
  # Linux standard: /var/lib/samlguard/samlguard.db
  # Windows standard: C:\ProgramData\SAMLGuard\data\samlguard.db
  # Container standard: /data/samlguard.db
  path: "./data/samlguard.db"
  max_idle_conns: 1
  max_open_conns: 1
  enable_foreign_keys: true

saml:
  # SAMLGuard Entity ID (must match SP configuration in IT Advisor)
  entity_id: "https://samlguard.example.com/saml/metadata"
  # Downstream ACS URL (ITA SAML assertion callback)
  acs_url: "https://ita.example.com/api/current/authentication/saml2-callback"
  # SAMLGuard public SSO URL
  sso_url: "https://samlguard.example.com/saml/sso"
  slo_url: "https://samlguard.example.com/saml/slo"
  metadata_url: "https://samlguard.example.com/saml/metadata"
  
  # Cryptographic credentials for signing downstream SAML responses
  cert_file: "./cert/saml-signing.crt"
  key_file: "./cert/saml-signing.key"
  sign_requests: true
  sign_assertions: true
  sign_responses: true

  # Active Upstream Identity Provider profile ("entra", "keycloak", "custom"; never "simulator" in production)
  # Specify multiple entries in enabled_idps to show a front-end sign-in method chooser.
  active_idp: "entra"
  enabled_idps:
    - "entra"
  # Upstream Identity Provider (e.g., Microsoft Entra ID, Okta, PingIdentity)
  idp_entity_id: "https://login.microsoftonline.com/your-tenant-id/v2.0"
  idp_sso_url: "https://login.microsoftonline.com/your-tenant-id/saml2"
  idp_cert_file: "./cert/upstream-idp.crt"
  
  allowed_audiences:
    - "https://ita.example.com"
    - "https://samlguard.example.com"
  downstream_acs_urls:
    - "https://ita.example.com/api/current/authentication/saml2-callback"

  # AuthnContextClassRef: leave empty for dynamic per-method selection
  # (TimeSyncToken for TOTP, unspecified for Email OTP)
  authn_context_class_ref: ""

  # Explicit mapping from upstream IdP role claims to IT Advisor groups
  group_mapping:
    "ITAdvisor-Admins": "Admin"
    "ITAdvisor-Operators": "Operator"
    "ITAdvisor-Viewers": "Viewer"
  default_groups: []

mfa:
  # Activate one or multiple OTP providers simultaneously ("totp", "email", "sms")
  enabled_providers:
    - "totp"
    - "email"
  # "totp", "email", "sms", or "select" (shows "Select a method to verify your identity" list first when multiple OTPs are active)
  default_provider: "totp"
  issuer: "SAMLGuard"
  max_retries: 5
  otp_expiry: 5m
  otp_length: 6
  backup_code_count: 10
  backup_code_length: 8
  rate_limit_window: 15m
  trust_device_days: 30
  resend_cooldown: 60s
  totp_skew: 1
  # NEVER enable dummy OTP in production
  allow_dummy_otp: false
  # 64-character (32-byte) hex-encoded AES key for TOTP secrets encryption
  encryption_key: "CHANGE_ME_GENERATE_64_CHAR_HEX_KEY_FOR_AES_ENCRYPTION"
  # High-entropy server secret pepper for Email OTP HMAC digests
  server_pepper: "CHANGE_ME_GENERATE_HIGH_ENTROPY_SERVER_PEPPER"

smtp:
  host: "smtp.mailgun.org"
  port: 587
  username: "postmaster@samlguard.example.com"
  password: "YOUR_SMTP_PASSWORD"
  from: "no-reply@samlguard.example.com"
  from_name: "SAMLGuard MFA Security"
  encryption: "starttls"

sms:
  # Cloud APIs: "twilio", "isms", "vonage"
  # Hardware Appliances & Cellular Gateways: "sendquick", "smseagle", "multitech", "teltonika"
  # Generic Webhook / USB Modem Bridge / Dev Mock: "custom"
  provider: "twilio"
  api_url: "https://api.twilio.com/2010-04-01"
  account_id: "YOUR_TWILIO_ACCOUNT_SID_OR_GATEWAY_USERNAME"
  auth_token: "YOUR_SMS_AUTH_TOKEN_OR_PASSWORD"
  sender_id: "+15551234567"
  http_method: "POST"
  message_template: "Your SAMLGuard verification code is {code}. Valid for 5 minutes."
  profiles:
    twilio:
      api_url: "https://api.twilio.com/2010-04-01"
      sender_id: "+15551234567"
    isms:
      api_url: "https://www.isms.com.my/isms_send_all_id.php"
      sender_id: "SAMLGuard"
    sendquick:
      api_url: "https://sendquick.example.local/sq/sendmsg.php"
      sender_id: "SAMLGuard"
    smseagle:
      api_url: "https://smseagle.example.local/index.php/http_api/send_sms"
      http_method: "POST"
    multitech:
      api_url: "https://multitech.example.local/sendmsg"
      http_method: "GET"
    teltonika:
      api_url: "https://teltonika.example.local/cgi-bin/sms_send"
      http_method: "GET"
    vonage:
      api_url: "https://rest.nexmo.com/sms/json"
      sender_id: "SAMLGuard"

security:
  # Dedicated high-entropy HMAC secret for Admin Console sessions and CSRF tokens
  csrf_secret: "CHANGE_ME_GENERATE_HIGH_ENTROPY_ADMIN_CSRF_SECRET"
  # Global API/gateway requests per minute per client IP
  rate_limit: 100
  # Strict auth endpoint requests per minute per IP (/admin/login, /mfa/verify, /saml/acs)
  auth_rate_limit: 20
  # Explicit reverse proxy IPs or CIDRs allowed to supply X-Forwarded-For / X-Forwarded-Proto
  trusted_proxies: []

ita:
  api_url: "https://ita.example.com/api/current"
  api_username: "apc"
  api_password: "YOUR_ITA_API_PASSWORD"
  # Pin internal CA certificate PEM for self-signed / private PKI ITA servers
  tls_ca_file: ""
  tls_insecure_skip_verify: false
  enforce_user_whitelist: true

logging:
  level: "info"
  format: "json"
  output_path: "stdout"

metrics:
  enabled: true
  path: "/metrics"
  # In production /metrics requires Admin Console session or Authorization: Bearer <bearer_token>
  require_auth: true
  bearer_token: ""

